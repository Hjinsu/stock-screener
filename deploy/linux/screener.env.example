# 서버 환경 파일 견본 — 실제 파일은 /etc/stock-screener/screener.env (root:screener 0640).
# install.sh 가 이 견본으로 생성하고 DB 비밀번호만 무작위로 채운다. 나머지 키는 'sudoedit' 로 직접 입력한다.
# 이 견본에는 어떤 실제 값도 넣지 않는다(저장소에 커밋되는 파일).

# ---- 경로·DB ----
SCREENER_HOME=/var/lib/stock-screener
SCREENER_DB_URL=jdbc:mariadb://127.0.0.1:3306/screener
SCREENER_DB_USER=screener
SCREENER_DB_PASSWORD=
# 서버는 systemd 타이머로 실행 — 앱 내 스케줄러 끔(이중 실행 방지)
SCREENER_INAPP_SCHEDULER=off
SCREENER_PORT=8765

# ---- 필수 API ----
KRX_API_KEY=
DART_API_KEY=
SEC_USER_AGENT=

# ---- 선택 API ----
TIINGO_API_KEY=
FMP_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ECOS_API_KEY=
